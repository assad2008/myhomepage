# Cloudflare 本地调试变量（wrangler pages dev 会读取此文件）
# 复制为 .dev.vars 并填入真实值；.dev.vars 已被 .gitignore 忽略，切勿提交。

MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain
MAIL_RECIPIENT=your-email@example.com

# 可选：Mailgun 区域。默认 us；欧洲区填 eu
# MAILGUN_REGION=us

# 可选：地区限制开关。默认 true（仅允许中国大陆 CN 发送）
# RESTRICT_CN_ONLY=true
